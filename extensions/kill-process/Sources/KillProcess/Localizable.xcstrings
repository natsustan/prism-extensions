      }
    },
    "%@ quits and reopens." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@将退出并重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@將會結束並重新開啟。"
          }
        }
      }
    },
    "%@ quits at once and reopens." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@将立即退出并重新打开。"
