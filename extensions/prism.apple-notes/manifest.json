{
  "protocol": 1,
  "id": "prism.apple-notes",
  "name": "Apple Notes",
  "version": "1.0.0",
  "author": "Prism",
  "description": "Search your Apple Notes by title, folder, content, tags, or pinyin, and open them in Notes.",
  "icon": { "symbol": "note.text", "tint": "gold", "app": "com.apple.Notes" },
  "executable": ".build/release/AppleNotes",
  "commands": [
    { "id": "search-notes", "title": "Search Notes", "subtitle": "Apple Notes", "mode": "list", "keywords": ["notes", "apple notes", "find note", "memo", "备忘录", "笔记"] }
  ],
  "folders": [
    { "id": "notes", "path": "~/Library/Group Containers/group.com.apple.notes", "reason": "Apple Notes searches your notes in this folder and never changes them." }
  ],
  "capabilities": ["readHomeFiles"]
}
