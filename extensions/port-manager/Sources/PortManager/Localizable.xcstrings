{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ quits at once, without a chance to clean up." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@将立即退出，来不及做清理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@將立即結束，來不及做清理。"
          }
        }
      }
    },
    "%@ stops listening on %@ and quits." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@将停止监听%2$@ 并退出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@將停止監聽%2$@ 並結束。"
          }
        }
      }
    },
