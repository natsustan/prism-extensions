{
  "protocol": 1,
  "id": "prism.caffeinate",
  "name": "Caffeinate",
  "version": "1.2.0",
  "author": "Prism",
  "description": "Keep your Mac awake from the launcher, a hotkey, or a widget.",
  "icon": { "symbol": "cup.and.saucer.fill", "tint": "brown" },
  "executable": ".build/release/Caffeinate",
  "commands": [
    { "id": "caffeinate", "title": "Caffeinate", "subtitle": "Coffee", "mode": "no-view", "keywords": ["keep awake", "prevent sleep", "coffee"] },
    { "id": "caffeinate-status", "title": "Caffeinate Status", "subtitle": "Coffee", "mode": "no-view", "keywords": ["awake", "sleep", "coffee"], "liveStatus": true },
    { "id": "decaffeinate", "title": "Decaffeinate", "subtitle": "Coffee", "mode": "no-view", "keywords": ["allow sleep", "stop caffeinate", "coffee"] },
    { "id": "toggle-caffeinate", "title": "Toggle Caffeinate", "subtitle": "Coffee", "mode": "no-view", "keywords": ["keep awake", "allow sleep", "coffee"] }
  ],
  "preferences": [
    { "id": "preventDiskSleep", "type": "bool", "title": "Prevent Disk Sleep", "caption": "Prevents the disk from idle sleeping the next time Caffeinate starts. It does not prevent screen locking or lid-close sleep.", "default": false }
  ],
  "widgets": [
    { "id": "toggle", "title": "Caffeinate", "subtitle": "Keep your Mac awake", "template": "toggleCard" }
  ],
  "tasks": [
    { "id": "caffeinate", "executable": "/usr/bin/caffeinate", "survivesHost": true }
  ],
  "capabilities": ["hostTasks", "inspectProcesses"],
  "localizations": {
    "zh-Hans": {
      "name": "保持唤醒",
      "description": "从启动器、快捷键或小组件让你的 Mac 保持唤醒。",
      "commands": {
        "caffeinate": {"title": "保持唤醒", "subtitle": "咖啡", "keywords": ["防止睡眠", "不睡眠", "唤醒", "咖啡因"]},
        "caffeinate-status": {"title": "保持唤醒状态", "subtitle": "咖啡", "keywords": ["唤醒", "睡眠", "咖啡因"]},
        "decaffeinate": {"title": "允许睡眠", "subtitle": "咖啡", "keywords": ["允许睡眠", "停止保持唤醒", "咖啡因"]},
        "toggle-caffeinate": {"title": "切换保持唤醒", "subtitle": "咖啡", "keywords": ["防止睡眠", "允许睡眠", "咖啡因"]}
      },
      "preferences": {
        "preventDiskSleep": {"title": "防止磁盘睡眠", "caption": "下次开始保持唤醒时，防止磁盘闲置睡眠。不会阻止屏幕锁定，也不会阻止合上盖子后的睡眠。"}
      },
      "widgets": {
        "toggle": {"title": "保持唤醒", "subtitle": "让你的 Mac 保持唤醒"}
      }
    },
    "zh-Hant": {
      "name": "保持喚醒",
      "description": "從啟動器、快速鍵或小工具讓你的 Mac 保持喚醒。",
      "commands": {
        "caffeinate": {"title": "保持喚醒", "subtitle": "咖啡", "keywords": ["防止睡眠", "不睡眠", "喚醒", "咖啡因"]},
        "caffeinate-status": {"title": "保持喚醒狀態", "subtitle": "咖啡", "keywords": ["喚醒", "睡眠", "咖啡因"]},
        "decaffeinate": {"title": "允許睡眠", "subtitle": "咖啡", "keywords": ["允許睡眠", "停止保持喚醒", "咖啡因"]},
        "toggle-caffeinate": {"title": "切換保持喚醒", "subtitle": "咖啡", "keywords": ["防止睡眠", "允許睡眠", "咖啡因"]}
      },
      "preferences": {
        "preventDiskSleep": {"title": "防止磁碟睡眠", "caption": "下次開始保持喚醒時，防止磁碟閒置睡眠。不會阻止螢幕鎖定，也不會阻止闔上螢幕後的睡眠。"}
      },
      "widgets": {
        "toggle": {"title": "保持喚醒", "subtitle": "讓你的 Mac 保持喚醒"}
      }
    }
  }
}
