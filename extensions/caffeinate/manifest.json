{
  "protocol": 1,
  "id": "prism.caffeinate",
  "name": "Caffeinate",
  "version": "1.2.0",
  "author": "Prism",
  "description": "Keep your Mac awake from the launcher, a hotkey, or a widget.",
  "icon": { "symbol": "cup.and.saucer.fill", "tint": "brown" },
  "executable": ".build/release/Caffeinate",
  "commands": [
    { "id": "caffeinate", "title": "Caffeinate", "subtitle": "Coffee", "mode": "no-view", "keywords": ["keep awake", "prevent sleep", "coffee"] },
    { "id": "caffeinate-status", "title": "Caffeinate Status", "subtitle": "Coffee", "mode": "no-view", "keywords": ["awake", "sleep", "coffee"], "liveStatus": true },
    { "id": "decaffeinate", "title": "Decaffeinate", "subtitle": "Coffee", "mode": "no-view", "keywords": ["allow sleep", "stop caffeinate", "coffee"] },
    { "id": "toggle-caffeinate", "title": "Toggle Caffeinate", "subtitle": "Coffee", "mode": "no-view", "keywords": ["keep awake", "allow sleep", "coffee"] }
  ],
  "preferences": [
    { "id": "preventDiskSleep", "type": "bool", "title": "Prevent Disk Sleep", "caption": "Prevents the disk from idle sleeping the next time Caffeinate starts. It does not prevent screen locking or lid-close sleep.", "default": false }
  ],
  "widgets": [
    { "id": "toggle", "title": "Caffeinate", "subtitle": "Keep your Mac awake", "template": "toggleCard" }
  ],
  "tasks": [
    { "id": "caffeinate", "executable": "/usr/bin/caffeinate", "survivesHost": true }
  ],
  "capabilities": ["hostTasks", "inspectProcesses"],
  "localizations": {
    "zh-Hans": {
      "name": "Caffeinate",
      "description": "给 Mac 喝杯咖啡，让它保持清醒。启动器、快捷键或小组件都能开关。",
      "commands": {
        "caffeinate": {"title": "喝杯咖啡", "subtitle": "咖啡", "keywords": ["保持唤醒", "防止睡眠", "不睡眠", "咖啡因"]},
        "caffeinate-status": {"title": "咖啡状态", "subtitle": "咖啡", "keywords": ["保持唤醒", "睡眠", "咖啡因"]},
        "decaffeinate": {"title": "放下咖啡", "subtitle": "咖啡", "keywords": ["允许睡眠", "停止保持唤醒", "咖啡因"]},
        "toggle-caffeinate": {"title": "咖啡开关", "subtitle": "咖啡", "keywords": ["保持唤醒", "防止睡眠", "允许睡眠", "咖啡因"]}
      },
      "preferences": {
        "preventDiskSleep": {"title": "也别让磁盘打盹", "caption": "下次喝咖啡时，磁盘也不会闲置睡眠。屏幕照样会锁定，合上盖子照样会睡眠。"}
      },
      "widgets": {
        "toggle": {"title": "Caffeinate", "subtitle": "给 Mac 喝杯咖啡"}
      }
    },
    "zh-Hant": {
      "name": "Caffeinate",
      "description": "給 Mac 喝杯咖啡，讓它保持清醒。啟動器、快速鍵或小工具都能開關。",
      "commands": {
        "caffeinate": {"title": "喝杯咖啡", "subtitle": "咖啡", "keywords": ["保持喚醒", "防止睡眠", "不睡眠", "咖啡因"]},
        "caffeinate-status": {"title": "咖啡狀態", "subtitle": "咖啡", "keywords": ["保持喚醒", "睡眠", "咖啡因"]},
        "decaffeinate": {"title": "放下咖啡", "subtitle": "咖啡", "keywords": ["允許睡眠", "停止保持喚醒", "咖啡因"]},
        "toggle-caffeinate": {"title": "咖啡開關", "subtitle": "咖啡", "keywords": ["保持喚醒", "防止睡眠", "允許睡眠", "咖啡因"]}
      },
      "preferences": {
        "preventDiskSleep": {"title": "也別讓磁碟打盹", "caption": "下次喝咖啡時，磁碟也不會閒置睡眠。螢幕照樣會鎖定，闔上螢幕照樣會睡眠。"}
      },
      "widgets": {
        "toggle": {"title": "Caffeinate", "subtitle": "給 Mac 喝杯咖啡"}
      }
    }
  }
}
